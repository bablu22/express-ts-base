#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Validate commit message format
# Allowed prefixes: feat, fix, docs, style, refactor, perf, test, chore, ci, build, revert
commit_msg=$(cat "$1")
pattern="^(feat|fix|docs|style|refactor|perf|test|chore|ci|build|revert)(\(.+\))?: .{1,100}"

if ! echo "$commit_msg" | grep -qP "$pattern"; then
  echo ""
  echo "❌ Invalid commit message format!"
  echo ""
  echo "Expected format: <type>(<scope>): <description>"
  echo ""
  echo "Types: feat | fix | docs | style | refactor | perf | test | chore | ci | build | revert"
  echo ""
  echo "Examples:"
  echo "  feat(auth): add JWT authentication"
  echo "  fix(users): handle duplicate email error"
  echo "  docs: update API documentation"
  echo ""
  exit 1
fi
