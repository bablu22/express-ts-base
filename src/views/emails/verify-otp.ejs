<table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0">
  <!-- Security Icon Header -->
  <tr>
    <td align="center" style="padding-bottom: 20px;">
      <table role="presentation" border="0" cellspacing="0" cellpadding="0">
        <tr>
          <td align="center" style="background-color: #f4f4f5; border: 1px solid #e4e4e7; border-radius: 50%; width: 52px; height: 52px; line-height: 52px; font-size: 24px;">
            🔒
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- Title -->
  <tr>
    <td align="center" style="font-size: 22px; font-weight: 700; color: #0f172a; padding-bottom: 8px; letter-spacing: -0.3px;">
      Verify Your Email Address
    </td>
  </tr>

  <!-- Subtitle -->
  <tr>
    <td align="center" style="font-size: 15px; color: #64748b; line-height: 1.6; padding-bottom: 28px;">
      Hi <strong style="color: #1e293b;"><%= name %></strong>, enter the security code below to complete your authentication and activate your account.
    </td>
  </tr>

  <!-- Hero OTP Box (Light Dashed Border, No Shadow) -->
  <tr>
    <td style="padding-bottom: 24px;">
      <table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" style="background-color: #fafafa; border: 1px dashed #d4d4d8; border-radius: 10px; padding: 24px 16px; text-align: center;">
        <tr>
          <td align="center" style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #6366f1; padding-bottom: 10px;">
            Your Verification Code
          </td>
        </tr>
        <tr>
          <td align="center" class="otp-digit-text" style="font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, Courier, monospace; font-size: 38px; font-weight: 800; color: #4f46e5; letter-spacing: 10px; line-height: 1;">
            <%= otp %>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- Expiry Pill (Light Amber Border) -->
  <tr>
    <td align="center" style="padding-bottom: 28px;">
      <table role="presentation" border="0" cellspacing="0" cellpadding="0">
        <tr>
          <td align="center" style="background-color: #fff7ed; border: 1px solid #ffedd5; color: #c2410c; font-size: 13px; font-weight: 600; padding: 6px 18px; border-radius: 16px;">
            ⏱️ Code expires in <strong><%= expiresInMinutes %> minutes</strong>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- Divider -->
  <tr>
    <td style="border-top: 1px solid #eaecf0; padding-bottom: 20px;"></td>
  </tr>

  <!-- Security Notice -->
  <tr>
    <td align="center" style="font-size: 13px; color: #94a3b8; line-height: 1.5;">
      If you did not request this verification code, no further action is required. Your account remains completely secure.
    </td>
  </tr>
</table>
