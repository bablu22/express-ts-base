<table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0">
  <!-- Celebration Icon Header -->
  <tr>
    <td align="center" style="padding-bottom: 20px;">
      <table role="presentation" border="0" cellspacing="0" cellpadding="0">
        <tr>
          <td align="center" style="background-color: #f0fdf4; border: 1px solid #dcfce7; border-radius: 50%; width: 52px; height: 52px; line-height: 52px; font-size: 24px;">
            🎉
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- Title -->
  <tr>
    <td align="center" style="font-size: 22px; font-weight: 700; color: #0f172a; padding-bottom: 8px; letter-spacing: -0.3px;">
      Welcome to <%= appName %>!
    </td>
  </tr>

  <!-- Subtitle -->
  <tr>
    <td align="center" style="font-size: 15px; color: #64748b; line-height: 1.6; padding-bottom: 28px;">
      Hi <strong style="color: #1e293b;"><%= name %></strong>, your email is verified and your account is now fully active.
    </td>
  </tr>

  <!-- Next Steps Card (Light Border, No Shadow) -->
  <tr>
    <td style="padding-bottom: 28px;">
      <table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" style="background-color: #fafafa; border: 1px solid #eaecf0; border-radius: 10px; padding: 20px;">
        <tr>
          <td style="font-size: 15px; font-weight: 700; color: #1e293b; padding-bottom: 10px;">
            🚀 What's Next?
          </td>
        </tr>
        <tr>
          <td>
            <ul style="margin: 0; padding-left: 20px; color: #475569; font-size: 14px; line-height: 1.8;">
              <li style="padding-bottom: 6px;">Explore your personalized application dashboard</li>
              <li style="padding-bottom: 6px;">Set up your security credentials and profile preferences</li>
              <li>Connect with backend APIs and real-time events</li>
            </ul>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- Divider -->
  <tr>
    <td style="border-top: 1px solid #eaecf0; padding-bottom: 20px;"></td>
  </tr>

  <!-- Help Notice -->
  <tr>
    <td align="center" style="font-size: 13px; color: #94a3b8; line-height: 1.5;">
      Have questions or need assistance? Reply directly to this email — our team is here to help!
    </td>
  </tr>
</table>
