# ====================
# Environment Variables
# ====================
NODE_ENV=development
PORT=3000
API_VERSION=v1
APP_NAME=my-app
PUBLIC_URL=http://localhost:3000

# ====================
# Database (PostgreSQL)
# ====================
POSTGRES_USER=myapp
POSTGRES_PASSWORD=myapp_secret
POSTGRES_DB=myapp_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL="postgresql://myapp:myapp_secret@localhost:5432/myapp_db?schema=public"

# ====================
# Redis
# ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
REDIS_URL="redis://:redis_secret@localhost:6379"

# ====================
# Logger
# ====================
LOG_LEVEL=debug

# ====================
# Security
# ====================
JWT_SECRET=your-super-secret-jwt-key-min-16-chars-change-in-prod
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# ====================
# SMTP Email
# ====================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="My App <noreply@my-app.com>"

# ====================
# Seeding
# ====================
SEED_RUN=false
